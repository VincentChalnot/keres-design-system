{
  "name": "@vchalnot/keres-design-system",
  "version": "0.6.0",
  "description": "Shared Tailwind design system for the Keres website (Hugo) and platform (Symfony/Vite)",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VincentChalnot/keres-design-system.git"
  },
  "homepage": "https://github.com/VincentChalnot/keres-design-system#readme",
  "bugs": {
    "url": "https://github.com/VincentChalnot/keres-design-system/issues"
  },
  "keywords": [
    "keres",
    "design-system",
    "tailwind",
    "tailwindcss-preset"
  ],
  "main": "tailwind.preset.js",
  "style": "src/keres.css",
  "exports": {
    ".": "./tailwind.preset.js",
    "./tailwind.preset": "./tailwind.preset.js",
    "./tailwind.preset.js": "./tailwind.preset.js",
    "./keres.css": "./src/keres.css",
    "./src/*": "./src/*",
    "./fonts/*": "./styleguide/fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "tailwind.preset.js",
    "src",
    "styleguide/fonts"
  ],
  "peerDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i src/keres.css -o dist/keres.css && cp dist/keres.css styleguide/keres.css",
    "build:min": "tailwindcss -c tailwind.config.js -i src/keres.css -o dist/keres.min.css --minify",
    "dev": "tailwindcss -c tailwind.config.js -i src/keres.css -o styleguide/keres.css --watch",
    "deploy": "npm run build && npx wrangler deploy",
    "styleguide": "node scripts/serve.mjs styleguide 4173"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postcss-import": "^17.0.0",
    "tailwindcss": "^3.4.17"
  },
  "publishConfig": {
    "access": "public"
  }
}
